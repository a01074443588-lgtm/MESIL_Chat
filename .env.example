# 실행환경: development | test | production
ENVIRONMENT=development

# SMCODI 호환 PostgreSQL 설정입니다. 비밀번호는 설치마다 새로 정하고 Git에 올리지 않습니다.
# DATABASE_URL을 직접 지정할 수도 있지만, 비워 두면 아래 항목으로 주소를 조합합니다.
DATABASE_URL=
DATABASE_SCHEMA=smcodi
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=55433
POSTGRES_USER=smcodi_chat
POSTGRES_PASSWORD=반드시-새로운-긴-비밀번호로-변경
POSTGRES_DB=smcodi_chat

# 독립 시험기관 식별정보입니다. 실제 기관 개인정보는 넣지 않습니다.
ORGANIZATION_CODE=silvermedical-demo
ORGANIZATION_NAME=실버메디컬 가명기관
ORGANIZATION_SERVICE_TYPE=facility_care

# 실제 접속 주소만 쉼표로 구분해 등록합니다. 특정 IP는 코드에 넣지 않습니다.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3100,http://127.0.0.1:3100
# Docker 개발 게이트웨이와 임시 외부 시험 주소를 함께 사용할 때 지정합니다.
CHAT_ORIGINS=http://localhost:8080,https://chat.silvermedical.kr

# HTTPS 운영에서는 반드시 true로 변경합니다.
COOKIE_SECURE=false
SESSION_HOURS=12
SESSION_COOKIE_NAME=smcodi_chat_session

# Caddy 같은 신뢰할 수 있는 내부 게이트웨이를 거칠 때만 true로 설정합니다.
TRUST_PROXY_HEADERS=false

# 같은 계정·접속지에서 15분 동안 5회 실패하면 일시 제한합니다.
LOGIN_ATTEMPT_WINDOW_MINUTES=15
LOGIN_PAIR_LIMIT=5
LOGIN_CLIENT_LIMIT=30

# AI 챌린지 심사 기간에만 역할별 가상계정 체험을 여는 서버 설정입니다.
# 브라우저에는 계정 비밀번호를 보내지 않으며, 종료시각 이후 기존 체험 세션도 즉시 차단됩니다.
REVIEWER_ACCESS_ENABLED=false
# REVIEWER_ACCESS_ENDS_AT=2026-08-31T23:59:59+09:00
REVIEWER_SESSION_MINUTES=45
# REVIEWER_CARE_USERNAME=replace-with-care-reviewer-account
# REVIEWER_SOCIAL_USERNAME=replace-with-social-reviewer-account
# REVIEWER_SECONDARY_USERNAME=replace-with-secondary-reviewer-account
REVIEWER_CHAT_ROOM_NAME=시설 전체방
# 32자 이상의 별도 난수값을 .env에만 저장합니다. 일반 로그인 비밀번호와 재사용하지 않습니다.
# REVIEWER_SESSION_SECRET=replace-with-at-least-32-random-characters
REVIEWER_RATE_LIMIT=8
REVIEWER_RATE_WINDOW_MINUTES=1
REVIEWER_SESSION_LIMIT_PER_CLIENT=4

# PostgreSQL은 항상 Alembic 마이그레이션으로 구조를 관리합니다.
AUTO_CREATE_SCHEMA=false

# 최초 1회 관리자 생성용입니다. 운영 전 강한 비밀번호로 변경하고 안전하게 보관합니다.
BOOTSTRAP_ADMIN_USERNAME=change-me
BOOTSTRAP_ADMIN_PASSWORD=change-this-password
BOOTSTRAP_ADMIN_NAME=시스템 관리자

# 개발 중에만 가상 직원 화면을 전환하는 특수 런처입니다.
# 제출·운영 환경에서는 반드시 false로 두고 안전점검 스크립트를 실행합니다.
DEV_LAUNCHER_ENABLED=false
DEV_LAUNCHER_USERNAME=local_dev_launcher
DEV_LAUNCHER_PASSWORD=change-this-development-only-password
DEV_LAUNCHER_NAME=개발자 사용자 전환
DEV_IMPERSONATION_MINUTES=120

# 이미지로 올린 손글씨 보고서는 사무실 PC의 로컬 Ollama로 판독합니다.
# 외부 API로 직원·어르신 자료를 보내지 않습니다.
OCR_PROVIDER=ollama
OCR_MODEL=qwen3-vl:8b-instruct
OCR_BASE_URL=http://127.0.0.1:11434
OCR_TIMEOUT_SECONDS=180
OCR_IMAGE_BANDS=3

# 실명은 로컬 OCR 이름 후보에만 사용하며 Git에 저장하지 않습니다.
SMCODI_RESIDENT_LEXICON_PATH=./data/smcodi_residents.local.json
# 케어포 읽기 전용 조회에서 만든 가명 명단과 내부 실명↔가명 매칭표입니다.
# 세 파일 모두 Git에서 제외하며 외부 AI로 보내지 않습니다.
CAREFOR_RESIDENT_ROSTER_PATH=./data/carefor_residents.local.json
CAREFOR_STAFF_ROSTER_PATH=./data/carefor_staff.local.json
CAREFOR_IDENTITY_MAP_PATH=./data/carefor_identity_map.local.json

# 음성파일은 채팅 전송 후 별도로 사무실 PC의 로컬 Whisper가 판독합니다.
# STT_LOCAL_* 경로는 현재 PC에서 실제 설치 위치를 확인한 뒤 .env에만 적습니다.
STT_ENABLED=false
STT_PROVIDER=local_whisper_service
STT_MODEL=whisper-small
STT_SERVICE_URL=http://127.0.0.1:8766
STT_DOCKER_SERVICE_URL=http://host.docker.internal:8766
STT_SHARED_TOKEN=change-this-local-stt-connection-token
STT_TIMEOUT_SECONDS=600
STT_LOCAL_HOST=0.0.0.0
STT_LOCAL_PORT=8766
STT_LOCAL_PYTHON_PATH=
STT_LOCAL_MODEL_PATH=

# 업무함에서 담당자가 버튼을 눌렀을 때만 AI가 초안을 정리합니다.
# chain: Nemotron API -> Qwen 35B -> Gemma 4 순서로 시도합니다.
# 외부 API에는 가명 시험자료만 전송하며, 담당자 확정 전에는 서류 후보가 되지 않습니다.
AI_REVIEW_PROVIDER=chain
AI_REVIEW_MODEL=qwen3.6:35b
AI_REVIEW_LOCAL_MODELS=qwen3.6:35b,gemma4:e4b
AI_REVIEW_BASE_URL=http://127.0.0.1:11434
AI_REVIEW_TIMEOUT_SECONDS=45
AI_REVIEW_EXTERNAL_ENABLED=false
NVIDIA_API_KEY=
NVIDIA_API_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NEMOTRON_MODEL=nvidia/nemotron-3-ultra-550b-a55b
NVIDIA_API_TIMEOUT_SECONDS=120
# 선택 대화 AI 정리는 오래 기다리거나 자동 재시도하지 않고 이 시간 안에 끝냅니다.
NVIDIA_SUMMARY_TIMEOUT_SECONDS=45

# 휴대전화 화면이 꺼져 있어도 운영체제 알림을 보내기 위한 Web Push 설정입니다.
# 개인키는 Git에 넣지 말고 data/runtime 아래에 별도 보관합니다.
WEB_PUSH_ENABLED=false
WEB_PUSH_VAPID_PRIVATE_KEY_PATH=/data/runtime/webpush_vapid_private.pem
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_SUBJECT=https://chat.silvermedical.kr

# 한 메시지의 첨부 개수와 파일 하나의 최대 크기입니다(기본 30MB).
MAX_ATTACHMENTS_PER_MESSAGE=4
MAX_ATTACHMENT_BYTES=31457280
