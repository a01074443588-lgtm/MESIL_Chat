# 이 파일을 .env.production으로 복사한 뒤 모든 CHANGE_ME 값을 바꿉니다.
# .env.production은 Git에 올리지 않습니다.
ENVIRONMENT=production
CHAT_DOMAIN=chat.silvermedical.kr
CHAT_ORIGINS=https://chat.silvermedical.kr
ALLOWED_ORIGINS=https://chat.silvermedical.kr
COOKIE_SECURE=true
TRUST_PROXY_HEADERS=true
SESSION_HOURS=12
SESSION_COOKIE_NAME=smcodi_chat_session

DATABASE_SCHEMA=smcodi
POSTGRES_USER=smcodi_chat
POSTGRES_PASSWORD=CHANGE_ME_RANDOM_DATABASE_PASSWORD_AT_LEAST_24
POSTGRES_DB=smcodi_chat
AUTO_CREATE_SCHEMA=false

ORGANIZATION_CODE=silvermedical
ORGANIZATION_NAME=실버메디컬
ORGANIZATION_SERVICE_TYPE=facility_care

# 최초 관리자 생성에만 사용합니다. 첫 로그인과 비밀번호 변경 후에는 비워 둘 수 있습니다.
BOOTSTRAP_ADMIN_USERNAME=CHANGE_ME_ADMIN_ID
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_RANDOM_ADMIN_PASSWORD_AT_LEAST_16
BOOTSTRAP_ADMIN_NAME=시스템 관리자

DEV_LAUNCHER_ENABLED=false
DEV_LAUNCHER_USERNAME=
DEV_LAUNCHER_PASSWORD=
DEV_LAUNCHER_NAME=

LOGIN_ATTEMPT_WINDOW_MINUTES=15
LOGIN_PAIR_LIMIT=5
LOGIN_CLIENT_LIMIT=30

# AI 챌린지 심사 기간에만 사용합니다. 실제 계정명과 서명키는 비공개
# .env.production에만 저장하고, 심사 종료 후 반드시 false로 변경합니다.
REVIEWER_ACCESS_ENABLED=false
# REVIEWER_ACCESS_ENDS_AT=2026-08-31T23:59:59+09:00
REVIEWER_SESSION_MINUTES=45
# REVIEWER_CARE_USERNAME=CHANGE_ME_REVIEWER_CARE_USERNAME
# REVIEWER_SOCIAL_USERNAME=CHANGE_ME_REVIEWER_SOCIAL_USERNAME
# REVIEWER_SECONDARY_USERNAME=CHANGE_ME_REVIEWER_SECONDARY_USERNAME
REVIEWER_CHAT_ROOM_NAME=시설 전체방
# REVIEWER_SESSION_SECRET=CHANGE_ME_RANDOM_AT_LEAST_32_CHARACTERS
REVIEWER_RATE_LIMIT=8
REVIEWER_RATE_WINDOW_MINUTES=1
REVIEWER_SESSION_LIMIT_PER_CLIENT=4

MAX_ATTACHMENTS_PER_MESSAGE=4
MAX_ATTACHMENT_BYTES=31457280

# AI와 음성 판독은 운영 초기에는 꺼 둡니다. 서버 안의 로컬 모델 준비 후 켭니다.
OCR_PROVIDER=ollama
OCR_MODEL=qwen3-vl:8b-instruct
OCR_BASE_URL=http://host.docker.internal:11434
OCR_TIMEOUT_SECONDS=180
OCR_IMAGE_BANDS=3

STT_ENABLED=false
STT_PROVIDER=local_whisper_service
STT_MODEL=whisper-small
STT_DOCKER_SERVICE_URL=http://host.docker.internal:8766
STT_SHARED_TOKEN=CHANGE_ME_RANDOM_LOCAL_STT_TOKEN_AT_LEAST_24
STT_TIMEOUT_SECONDS=600

AI_REVIEW_PROVIDER=chain
AI_REVIEW_MODEL=qwen3.6:35b
AI_REVIEW_LOCAL_MODELS=qwen3.6:35b,gemma4:e4b
AI_REVIEW_BASE_URL=http://host.docker.internal:11434
AI_REVIEW_TIMEOUT_SECONDS=45
AI_REVIEW_EXTERNAL_ENABLED=false
NVIDIA_API_KEY=
NVIDIA_API_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NEMOTRON_MODEL=nvidia/nemotron-3-ultra-550b-a55b
NVIDIA_API_TIMEOUT_SECONDS=120
NVIDIA_SUMMARY_TIMEOUT_SECONDS=45
